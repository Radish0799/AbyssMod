<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2.1.0_fix 反編譯版（ilspycmd 11.2）。設環境變數 ABYSS_GAME_DIR 指向 ドットアビスX 安裝目錄，
       且該目錄已跑過一次 BepInEx（產生 BepInEx\interop）。 -->
  <PropertyGroup>
    <GameDir Condition="'$(ABYSS_GAME_DIR)' != ''">$(ABYSS_GAME_DIR)</GameDir>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AbyssMod</AssemblyName>
    <RootNamespace />
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="AbyssMod.master_mapping.json" LogicalName="AbyssMod.master_mapping.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\plugins\AbyssMod\Utility.dll" Private="false" />
    <ProjectReference Include="..\AbyssCdnRouter\AbyssCdnRouter.csproj" Private="false" />
  </ItemGroup>
</Project>
